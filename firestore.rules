rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeMember(pid) {
      return signedIn() && exists(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid)).data.memberStatus == 'active';
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Every mutation goes through a validated callable; profile fields are allowlisted there.
      allow write: if false;
      match /memberships/{pid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    }
    match /projects/{pid} {
      allow read: if activeMember(pid);
      allow write: if false;
      match /members/{uid} { allow read: if activeMember(pid); allow write: if false; }
      match /tasks/{tid} {
        allow read: if activeMember(pid);
        allow write: if false;
        match /{history}/{id} {
          allow read: if activeMember(pid) && history in ['updates','submissions','reviews'];
          allow write: if false;
        }
      }
      match /activity/{id} { allow read: if activeMember(pid); allow write: if false; }
      match /insights/{id} { allow read: if activeMember(pid); allow write: if false; }
      match /reports/{id} { allow read: if activeMember(pid); allow write: if false; }
      match /invites/{id} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
